# Local Python / Conda / CUDA environments (15 GB+)
.env/
venv/
env/
.venv/
.conda/

# Raw dataset archive at root (extracted contents in data/ ARE tracked)
*.zip
*.tar
*.tar.gz
*.tgz

# data folder (dataset + preprocessed scenes/masks, regenerate with TADGS/scripts)
data/

# Training checkpoints and intermediate PLY/render dumps
runs/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# C++ / CUDA extension build artifacts
build/
dist/
*.egg-info/
*.so
*.o
*.a
.ninja_deps
.ninja_log

# IDE, OS, and temporary files
.vscode/
.idea/
.claude/
.cursor/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.log
/tmp/
*.pdf

# Third-party submodule fetched separately (see TADGS/README.md)
TADGS/TAD-GS/submodules/mmcv/

# TAD-GS render dumps: keep only the 3 GT/render pairs used by the visual-comparison figure
# (k=2 -> t=21, k=4 -> t=22, k=8 -> t=20); everything else is regenerable with
# TADGS/scripts/evaluate_all.py, render_all_frames.py and make_video.sh
TADGS/results/renders_*/*/*.png
!TADGS/results/renders_k2_cam00/*/cam00_frame0021.png
!TADGS/results/renders_k4_cam00/*/cam00_frame0022.png
!TADGS/results/renders_k8_cam00/*/cam00_frame0020.png
TADGS/results/renders_*/*.mp4
TADGS/results/dynamic_bbox_cam0*.mp4
